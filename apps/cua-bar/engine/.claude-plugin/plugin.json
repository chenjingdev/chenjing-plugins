{
  "name": "cuabar",
  "version": "0.9.1",
  "description": "Mac 전용 Codex CUA 연결기. Claude Code가 설치된 Codex의 앱·브라우저 제어 기능(CUA)을 부릅니다. 메뉴 막대 앱 CUA Bar 없이 플러그인만으로 쓰고, CUA Bar가 떠 있거나 앱이 등록한 cuabar MCP가 있으면 비켜 섭니다. 비공식 실험 버전이며 Codex 앱이 필요합니다.",
  "author": {
    "name": "chenjing"
  },
  "homepage": "https://github.com/chenjingdev/chenjing-plugins/tree/main/apps/cua-bar/engine",
  "repository": "https://github.com/chenjingdev/chenjing-plugins",
  "license": "MIT",
  "keywords": [
    "computer-use",
    "macos",
    "browser",
    "mcp"
  ],
  "mcpServers": {
    "cuabar": {
      "type": "stdio",
      "command": "${CLAUDE_PLUGIN_ROOT}/plugin-mcp.sh",
      "args": []
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__plugin_cuabar_cuabar__.*$",
        "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/claude-hook.sh\" plugin", "timeout": 10}]
      }
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/claude-hook.sh\" plugin", "timeout": 10}]}
    ],
    "SubagentStop": [
      {"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/claude-hook.sh\" plugin", "timeout": 10}]}
    ],
    "StopFailure": [
      {"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/claude-hook.sh\" plugin", "timeout": 10}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/claude-hook.sh\" plugin", "timeout": 10}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/claude-hook.sh\" plugin", "timeout": 10}]}
    ]
  }
}
